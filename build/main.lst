  99:Core/Src/main.c **** 
 100:Core/Src/main.c ****   // 送信メールボックスに空きがあったら送信開始
 101:Core/Src/main.c ****   if (0 < HAL_CAN_GetTxMailboxesFreeLevel(&hcan))
 102:Core/Src/main.c ****   {
